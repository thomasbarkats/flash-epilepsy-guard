{
  "manifest_version": 3,
  "name": "Flash and Epilepsy Guard",
  "version": "1.0.0",
  "author": "Thomas BARKATS",
  "description": "Detects intense light flashes on screen (videos, GIFs) and covers the area with a preventive warning to protect photosensitive users.",
  "default_locale": "en",
  "homepage_url": "https://github.com/thomasbarkats/flash-epilepsy-guard",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.bundle.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["main.bundle.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Flash & Epilepsy Guard",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "88",
  "offline_enabled": true
}
